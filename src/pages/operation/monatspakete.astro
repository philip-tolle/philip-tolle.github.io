---
import OfferPage from '../../components/OfferPage.astro';
import { monthlyOffer } from '../../data/detail-offers';
import MobileRailControls from '../../components/MobileRailControls.astro';
const pakete = [
  { pname: 'F&B Desk', titel: 'Karten & Bankettunterlagen', fuer: 'Für Häuser mit täglich wechselnden Karten — von der Tagung bis zur Halbpension.', einheiten: [
    { titel: 'Übernahme aller laufenden Karten', sub: 'Tages-, Wochen-, Tagungs- & HP' },
    { titel: 'Menü- & Preisänderungen inklusive', sub: 'termingerecht druckfertig' },
    { titel: '4 Event-Menükarten pro Monat', sub: 'aus Vorlagen — individuell gegen Aufpreis' },
    { titel: '1 Zusatzmaterial pro Monat', sub: 'Tischplan, Aufsteller oder Display' },
    { titel: 'Alle Formate geliefert', sub: 'Druck-PDF, Web-PDF & Grafik' },
    { titel: '30 Minuten Planungsgespräch', sub: 'jeden Monat, fester Termin' },
  ] },
  { pname: 'Content Desk', titel: 'Social Media & Redaktionsplanung', fuer: 'Für Häuser, die sichtbar bleiben wollen — ohne eigene Contentstelle.', einheiten: [
    { titel: 'Monatlicher Redaktionsplan', sub: 'saisonale Themen eingebunden' },
    { titel: '6 Beiträge pro Monat', sub: 'Instagram & Facebook' },
    { titel: '8 Story-Elemente', sub: 'passend zu den Beiträgen' },
    { titel: 'Komplett aus einer Hand', sub: 'Text, Gestaltung, Veröffentlichung' },
    { titel: 'Monatsbericht', sub: 'Zahlen statt Bauchgefühl' },
    { titel: '45 Minuten Planungsgespräch', sub: 'jeden Monat, fester Termin' },
  ] },
  { pname: 'Operation Partner', titel: 'Umfassende Begleitung', fuer: 'Für Häuser mit Restaurant, Bankett und regelmäßigem Projektbedarf.', einheiten: [
    { titel: 'Beide Desks komplett', sub: 'F&B + Content in vollem Umfang' },
    { titel: '12 Projektstunden pro Quartal', sub: 'flexibel einsetzbar' },
    { titel: 'Saison- & Kampagnenplanung', sub: 'viermal im Jahr' },
    { titel: 'Bevorzugte Bearbeitung', sub: 'festes Servicefenster' },
    { titel: '60 Minuten Steuerungsgespräch', sub: 'jeden Monat, fester Termin' },
    { titel: 'Projekt- & Aufgabenübersicht', sub: 'Status jederzeit einsehbar' },
  ] },
];
---
<OfferPage page={monthlyOffer} extraLinks={[{label: 'Die Pakete', href: '#pakete'}]}>
 <section class="detail-section" id="pakete"><div class="detail-intro"><div><p class="detail-kicker">Die Pakete im Überblick</p><h2>Ein fester Rahmen.<em>Eine klare Leistung.</em></h2></div><p>Den genauen Umfang und den Preis vereinbaren wir vor dem Start in einem schriftlichen Angebot.</p></div>
 <div data-mobile-rail><div class="detail-grid" data-mobile-rail-track tabindex="0" aria-label="Monatspakete: horizontal wischen oder mit den Pfeiltasten bewegen">{pakete.map(p => <article class="detail-card detail-package" data-mobile-rail-card><p class="detail-kicker">{p.pname}</p><h3>{p.titel}</h3><ul class="detail-list">{p.einheiten.map(e => <li><strong>{e.titel}</strong>{e.sub}</li>)}</ul><p>{p.fuer}</p><a class="detail-button" href={'/kontakt/?thema=entlastung&angebot=' + encodeURIComponent(p.pname) + '#contactform'}>Paket anfragen <span aria-hidden="true">↗</span></a></article>)}</div><MobileRailControls count={pakete.length} noun="Pakete" /></div>
 <p class="detail-note">Die Leistungen im Detail: <a href="/operation/karten-unterlagen/">Karten &amp; Unterlagen</a> · <a href="/operation/gaestekommunikation/">Gästekommunikation &amp; Inhalte</a>.</p>
 <p class="detail-note">Mindestlaufzeit sechs Monate, danach monatlich kündbar. Beim Einstieg über den 30-Tage-Test ist die Einrichtung inklusive. Zusätzliche Aufgaben und Fremdkosten werden separat vereinbart. Newsletter-Umfang nach gesonderter Abstimmung. Zum Kennenlernen eignet sich der <a href="/operation/30-tage-test/">30-Tage-Test</a>.</p>
 </section>
</OfferPage>
