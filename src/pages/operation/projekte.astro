---
import OfferPage from '../../components/OfferPage.astro';
import DetailRows from '../../components/DetailRows.astro';
import { projectsOffer } from '../../data/detail-offers';
const projekte = [
  { titel: 'Saisonkampagne', text: 'Idee, Angebotsstruktur, Sonderkarte, Content und Aushänge — mit klarem Zeitplan.' },
  { titel: 'Weihnachtsgeschenke: Konzept', text: 'Zielgruppen, Budgetstaffeln, Ideen, Lieferanten und Muster — entscheidungsreif.' },
  { titel: 'Weihnachtsgeschenke: Komplett', text: 'Bestellung, Verpackung, Grußkarten, Termine und Verteilung — alles koordiniert.' },
  { titel: 'Sommer- & Mitarbeiterfest', text: 'Vom Motto-Konzept mit Budgetrahmen und Checkliste bis zur vollständigen Planung.' },
  { titel: 'Bankett- & Gästemappe', text: 'Struktur, Texte, Design — als Druck- und PDF-Version, die Ihrem Haus gerecht wird.' },
  { titel: 'Content-Tag vor Ort', text: 'Ein Tag bei Ihnen im Haus: die Bild- und Videobasis für Monate an Inhalten.' },
];
---
<OfferPage page={projectsOffer} extraLinks={[{label: 'Beispiele', href: '#projekte'}]}><section class="detail-section" id="projekte"><div class="detail-intro"><div><p class="detail-kicker">Typische Projekte</p><h2>Ein Anfang<em>für Ihr Vorhaben.</em></h2></div><p>Konkrete Aufträge mit einem eigenen Ergebnis: von der Saisonaktion bis zur Gästemappe. Den passenden Umfang stimmen wir mit Ihnen ab.</p></div><DetailRows items={projekte.map(p => ({title:p.titel,text:p.text,href:'/kontakt/?thema=entlastung&angebot=' + encodeURIComponent(p.titel) + '#contactform',action:'Projekt anfragen'}))} /><p class="detail-note">Umfang und Festpreis vereinbaren wir individuell vor dem Start. Fremdkosten wie Druck, Geschenke und Versand stehen separat im Angebot.</p></section></OfferPage>
