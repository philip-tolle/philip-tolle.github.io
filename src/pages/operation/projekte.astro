---
import OfferPage from '../../components/OfferPage.astro';
import DetailRows from '../../components/DetailRows.astro';
import { projectsOffer } from '../../data/detail-offers';
const projekte = [
  { titel: 'Saisonkampagne', text: 'Idee, Angebotsstruktur, Sonderkarte, Content und Aushänge — mit klarem Zeitplan.', preis: 'ab 1.250 €' },
  { titel: 'Weihnachtsgeschenke: Konzept', text: 'Zielgruppen, Budgetstaffeln, Ideen, Lieferanten und Muster — entscheidungsreif.', preis: 'ab 1.500 €' },
  { titel: 'Weihnachtsgeschenke: Komplett', text: 'Bestellung, Verpackung, Grußkarten, Termine und Verteilung — alles koordiniert.', preis: 'ab 2.900 €' },
  { titel: 'Sommer- & Mitarbeiterfest', text: 'Vom Motto-Konzept mit Budgetrahmen und Checkliste bis zur vollständigen Planung.', preis: 'ab 1.800 €' },
  { titel: 'Bankett- & Gästemappe', text: 'Struktur, Texte, Design — als Druck- und PDF-Version, die Ihrem Haus gerecht wird.', preis: 'ab 2.000 €' },
  { titel: 'Content-Tag vor Ort', text: 'Ein Tag bei Ihnen im Haus: die Bild- und Videobasis für Monate an Inhalten.', preis: 'ab 890 €' },
];
---
<OfferPage page={projectsOffer} extraLinks={[{label: 'Beispiele & Preise', href: '#projekte'}]}><section class="detail-section" id="projekte"><div class="detail-intro"><div><p class="detail-kicker">Typische Projekte</p><h2>Ein Anfang<em>für Ihr Vorhaben.</em></h2></div><p>Konkrete Aufträge mit einem eigenen Ergebnis: von der Saisonaktion bis zur Gästemappe. Den passenden Umfang stimmen wir mit Ihnen ab.</p></div><DetailRows items={projekte.map(p => ({title:p.titel,text:p.text,price:p.preis,href:'/kontakt/?thema=entlastung&angebot=' + encodeURIComponent(p.titel) + '#contactform',action:'Projekt anfragen'}))} /><p class="detail-note">Alle Preise netto, als Ab-Preise. Der genaue Umfang wird individuell vereinbart. Fremdkosten wie Druck, Geschenke und Versand trägt Ihr Haus direkt.</p></section></OfferPage>
