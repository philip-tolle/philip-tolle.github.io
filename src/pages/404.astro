---
import DetailLayout from '../layouts/DetailLayout.astro';
import { wege } from '../data/wege';
---
<DetailLayout title="Seite nicht gefunden | NextCourse" description="Diese Adresse wurde nicht gefunden. Hier gelangen Sie zu den Leistungen und zum Kontakt." label="404 · Seite nicht gefunden" heading="Hier geht es" emphasis="auf einem anderen Weg weiter." lead="Diese Adresse gibt es nicht oder sie hat sich geändert. Über die Startseite und die vier Wege finden Sie wieder zum passenden Angebot." action="Zur Startseite" href="/" secondary={{label:'Kontakt aufnehmen',href:'/kontakt/'}} contact={false} noindex>
<section class="detail-section"><div class="detail-grid detail-grid--two">{wege.map(w=><a href={w.href} class="detail-card"><h2>{w.title}</h2><p>{w.claim} {w.emphasis}</p><span class="detail-link">Entdecken ↗</span></a>)}</div></section>
</DetailLayout>
