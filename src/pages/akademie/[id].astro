---
import {getCollection,render} from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';
import DetailRows from '../../components/DetailRows.astro';
import training from '../../assets/offers/inhouse-schulung.png';
import seminar from '../../assets/services/academy-team-orange.png';
export async function getStaticPaths(){return(await getCollection('kurse')).map(kurs=>({params:{id:kurs.id},props:{kurs}}));}
const {kurs}=Astro.props;
const {Content}=await render(kurs);const d=kurs.data;
const isKi=kurs.id==='ki-grundlagen';
const href='/kontakt/?thema=academy&angebot='+encodeURIComponent(d.title)+'#contactform';
const schema=JSON.stringify({'@context':'https://schema.org','@type':'Course',name:d.title,description:d.kurz,provider:{'@type':'Organization',name:'NextCourse',sameAs:'https://www.next-course.de/'},availableLanguage:'de'}).replace(/</g,'\\u003c');
---
<DetailLayout offer title={d.title+' | NextCourse Academy'} description={d.kurz} area="academy" label={d.kategorie} heading={isKi?'KI im Geschäftsalltag.':d.title} emphasis={isKi?'Für Hotel & Gastronomie.':undefined} lead={d.kurz} image={isKi?seminar:training} imageAlt="Illustration einer Schulung mit einem Serviceteam im eigenen Betrieb" caption={d.botschaft} action={d.status==='geplant'?'Interesse vormerken':'Termin anfragen'} href={href} secondary={{label:'Inhalte entdecken',href:'#inhalte'}} facts={[d.status==='geplant'?'In Vorbereitung':'Termin auf Anfrage',d.dauer,d.format]}>
<script type="application/ld+json" set:html={schema} slot="head" />
<nav class="offer-navigation" aria-label="Auf dieser Schulungsseite"><a href="#inhalte">Für wen &amp; warum</a><a href="#lerninhalte">Lerninhalte</a><a href="#ergebnisse">Das nehmen Sie mit</a><a href="#rahmen">Termin &amp; Rahmen</a>{isKi && <a href="#seminarfragen">Häufige Fragen</a>}</nav>
<section class="detail-section detail-aside-layout" id="inhalte"><div><p class="detail-kicker">Lernen mit Bezug zu Ihrem Alltag</p><h2>Verstehen. Ausprobieren. <em>Im Haus anwenden.</em></h2><div class="detail-prose"><Content /></div><h3>Für wen das Angebot gedacht ist</h3><p>{d.zielgruppe}</p></div><aside class="detail-card" id="rahmen" style="scroll-margin-top:7rem"><p class="detail-kicker">Gut zu wissen</p><h3>Der Rahmen</h3><ul class="detail-list"><li><strong>Dauer</strong>{d.dauer}</li><li><strong>Format</strong>{d.format}</li><li><strong>Preis &amp; Voraussetzungen</strong>{d.foerderung}</li><li><strong>Verfügbarkeit</strong>{d.status==='geplant'?'Das Angebot wird vorbereitet. Termine und verbindlicher Umfang stehen noch nicht fest.':'Den passenden Termin und den Umfang stimmen wir persönlich ab.'}</li></ul><a class="detail-button" href={href}>{d.status==='geplant'?'Interesse mitteilen':'Angebot anfragen'} <span aria-hidden="true">↗</span></a><p class="detail-note">Ihre Anfrage ist unverbindlich. Sie erhalten die konkreten Konditionen vor einer Buchung.</p></aside></section>
<section class="detail-section offer-benefits" id="lerninhalte"><div class="detail-intro"><h2>{d.status==='geplant'?'Die geplanten Inhalte.':'Das bearbeiten wir gemeinsam.'}</h2><p>Die Beispiele kommen aus Hotel und Gastronomie. So lässt sich das Gelernte auf Ihren Betrieb übertragen.</p></div><DetailRows items={d.module.map(m=>({title:m.titel,text:m.text}))} /></section>
<section class="detail-section detail-intro" id="ergebnisse"><div><p class="detail-kicker">Ihr Nutzen</p><h2>{d.status==='geplant'?'Was Sie künftig':'Was Sie'} <em>mitnehmen{d.status==='geplant'?' sollen.':'.'}</em></h2></div><ul class="detail-list">{d.ergebnisse.map(e=><li>{e}</li>)}</ul></section>
{isKi && <section class="detail-section" id="seminarfragen"><div class="detail-faq offer-faq"><div><p class="detail-kicker">Vor der Anmeldung</p><h2>Ihre Fragen <em>zum Einstieg.</em></h2></div><div>
  <details><summary>Brauche ich KI-Vorkenntnisse?</summary><p>Nein. Wir beginnen mit den Grundlagen und arbeiten mit Aufgaben aus Hotel und Gastronomie. Welches Gerät und welche Zugänge für die Übungen gebraucht werden, klären wir vor dem Termin.</p></details>
  <details><summary>Kann unser ganzes Team teilnehmen?</summary><p>Ja. Als <a class="detail-link" href="/akademie/flying-academy/">Flying Academy</a> findet die Schulung in Ihrem Haus statt. Gruppengröße, Vorkenntnisse und geeignete Beispiele stimmen wir vorab mit Ihnen ab.</p></details>
  <details><summary>Was nehme ich aus der Schulung mit?</summary><p>Sie nehmen konkrete Anwendungsfälle, Prompts und Vorlagen sowie einen Teilnahmenachweis mit. Gemeinsam besprechen wir, welche Anwendungen zu Ihren Aufgaben passen und was Sie weiter üben können.</p></details>
  <details><summary>Wie buche ich einen Termin?</summary><p>Fragen Sie mit Ihrer gewünschten Teilnehmerzahl und einem groben Zeitraum an. Vor der Buchung erhalten Sie ein Angebot mit Termin, Umfang und Preis.</p><a class="detail-link" href={href}>KI-Seminar anfragen <span aria-hidden="true">↗</span></a></details>
</div></div></section>}
</DetailLayout>
