---
// Ein persönlicher Brief statt Werbetext (Designkammer: galerie/noma).
import { Image } from 'astro:assets';
import philip from '../assets/philip.png';
---
<section class="home-brief nc-section nc-shell nc-paper" aria-labelledby="brief-title">
  <article class="home-brief__paper reveal">
    <p class="nc-kicker">Ein persönliches Wort</p>
    <h2 id="brief-title">Liebe Gastgeberinnen und Gastgeber,</h2>
    <p>ich bin seit vielen Jahren in Hotellerie und Gastronomie zu Hause und kenne die Verantwortung, die Sie täglich tragen. Für Weiterbildung, Digitalisierung und Veränderung bleibt dabei oft zu wenig Zeit.</p>
    <p>Genau dafür gibt es NextCourse: Wir hören zu, bringen einen klaren Blick von außen mit und kümmern uns um die Umsetzung.</p>
    <footer class="home-brief__sign">
      <Image src={philip} alt="" widths={[120, 240]} sizes="56px" width={240} format="webp" loading="lazy" />
      <span><span class="home-brief__hand">Philip Tolle</span><small>Gründer und Geschäftsführer</small></span>
    </footer>
  </article>
</section>

<style>
  .home-brief{padding-block:clamp(2rem,4vw,4rem) clamp(3rem,6vw,6rem)}
  .home-brief__paper{position:relative;max-width:44rem;margin:0 auto;padding:clamp(1.6rem,4vw,3rem);background:#fff;border:1px solid rgba(18,42,47,.12);border-radius:4px;box-shadow:0 2px 0 rgba(18,42,47,.05),0 30px 60px -40px rgba(18,42,47,.5);transform:rotate(-.6deg);color:var(--nc-forest)}
  .home-brief__paper::before{content:'';position:absolute;top:0;left:clamp(1.6rem,4vw,3rem);width:3.5rem;height:4px;background:var(--nc-coral)}
  .home-brief h2{font-family:Georgia,'Times New Roman',serif;font-weight:400;font-style:italic;letter-spacing:-.02em;font-size:clamp(1.5rem,2.4vw,2.1rem);color:var(--nc-forest);margin:0 0 1rem}
  .home-brief__paper>p:not(.nc-kicker){color:#3b4f53;margin:0 0 .9rem;max-width:58ch}
  .home-brief__sign{display:flex;align-items:center;gap:.9rem;margin-top:1.4rem}
  .home-brief__sign img{width:52px;height:52px;border-radius:50%;object-fit:cover;object-position:center 28%}
  .home-brief__hand{display:block;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:1.35rem;line-height:1.1}
  .home-brief__sign small{display:block;font-size:.75rem;color:#526664}
  @media(prefers-reduced-motion:reduce){.home-brief__paper{transform:none}}
</style>
