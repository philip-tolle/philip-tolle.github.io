---
import { Image } from 'astro:assets';
import logo from '../assets/nc-logo.png';
import philip from '../assets/philip.png';
import HomeServices from './HomeServices.astro';
import HomeTransition from './HomeTransition.astro';
import HandbookGateway from './HandbookGateway.astro';
import PersonalContact from './PersonalContact.astro';
import HomeZahlen from './HomeZahlen.astro';
import FuenfMomente from './FuenfMomente.astro';
import HomeSelbsttest from './HomeSelbsttest.astro';
import HomeStufen from './HomeStufen.astro';
import HomeBrief from './HomeBrief.astro';
import HomeFaden from './HomeFaden.astro';
const tippWorte = JSON.stringify(['Ihre Gäste.', 'Ihr Team.', 'sich selbst.', 'das, was zählt.']);
import '../styles/marketing.css';
import '../styles/home.css';
---
<div class="nc-page nc-home">
  <section class="home-hero nc-shell" aria-labelledby="home-title">
    <div class="home-hero__stage">
      <a class="heroLogo coin" id="heroLogo" href="#leistungen" aria-label="Logo drehen und die passende Unterstützung entdecken">
        <Image src={logo} alt="NextCourse Logo: Wellen und Pfeil aus warmem Holz" widths={[360, 640, 1080]} sizes="(max-width: 599px) 160px, min(440px, 70vw, calc(100svh - 550px))" width={1080} format="webp" quality={82} loading="eager" fetchpriority="high" />
      </a>
      <h1 class="heroWord" id="home-title"><span class="home-hero__desktop-title">NextCourse<span class="sr-only"> – Management, Academy und Operation für das Gastgewerbe in Mainfranken</span></span><span class="home-hero__mobile-title">Mehr Zeit für<span class="sr-only"> das, was zählt.</span><em aria-hidden="true" class="home-typer" data-typer={tippWorte}>das, was zählt.</em></span></h1>
      <p class="home-hero__promise">Mehr Zeit für <span class="sr-only">das, was zählt.</span><span aria-hidden="true" class="home-typer" data-typer={tippWorte}>das, was zählt.</span></p>
      <p class="home-hero__lead">Wir ordnen Abläufe, schulen Ihr Team und übernehmen laufende Aufgaben.<span>Für inhabergeführte Hotels und Gastronomie in Mainfranken.</span></p>
      <p class="home-hero__mobile-summary" data-mobile-hero-summary>Für inhabergeführte Hotels &amp; Gastronomie in Mainfranken.</p>
      <div class="nc-actions home-hero__actions">
        <a class="nc-button" href="#leistungen"><span class="home-hero__button-label desktop-overview-copy">Passende Unterstützung finden</span><span class="home-hero__button-label mobile-overview-copy">Angebote entdecken</span><span aria-hidden="true">↓</span></a>
        <a class="home-hero__contact" href="/kontakt/">Erstgespräch anfragen <span aria-hidden="true">↗</span><small>Kostenlos und unverbindlich</small></a>
      </div>
    </div>
    <div class="home-hero__foot">
      <a class="home-about" href="/ueber/" aria-label="Über NextCourse: Philip Tolle kennenlernen">
        <Image src={philip} alt="" width={120} format="webp" quality={82} />
        <span>Aus der Branche.<br /><strong>An Ihrer Seite.</strong><span class="home-about__label">Über NextCourse</span></span>
        <span class="home-about__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <HomeTransition from="dark" to="white" />
  <HomeFaden>
    <HomeServices />
    <HomeZahlen />
    <FuenfMomente />
    <HomeSelbsttest />
    <HomeTransition from="white" to="dark" reverse />
    <HandbookGateway />
    <HomeTransition from="dark" to="white" />
    <HomeStufen />
    <HomeBrief />
  </HomeFaden>
  <HomeTransition from="white" to="dark" reverse />
  <PersonalContact />
</div>

<script>
  (() => {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    document.querySelectorAll<HTMLElement>('[data-typer]').forEach(el => {
      const worte: string[] = JSON.parse(el.dataset.typer || '[]');
      const ende = worte[worte.length - 1];
      if (motion.matches || worte.length < 2 || el.offsetParent === null) return;
      const text = document.createTextNode('');
      const marke = document.createElement('span');
      marke.className = 'home-typer__marke';
      el.textContent = '';
      el.append(text, marke);
      let abbruch = false;
      const warte = (ms: number) => new Promise(r => setTimeout(r, ms));
      const zeichen = 1000 / 90;
      const fertig = () => { abbruch = true; text.data = ende; marke.classList.add('is-done'); };
      el.closest('h1, p')?.addEventListener('pointerdown', fertig, { once: true });
      (async () => {
        await warte(500);
        for (let w = 0; w < worte.length && !abbruch; w++) {
          const wort = worte[w];
          for (let i = 1; i <= wort.length && !abbruch; i++) {
            text.data = wort.slice(0, i);
            await warte(zeichen * 4 + (Math.random() < .08 ? 140 : 0));
          }
          if (w === worte.length - 1 || abbruch) break;
          await warte(1100);
          for (let i = wort.length; i >= 0 && !abbruch; i--) { text.data = wort.slice(0, i); await warte(zeichen * 2); }
          await warte(180);
        }
        if (!abbruch) fertig();
      })();
    });
  })();
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const logo = document.querySelector<HTMLAnchorElement>('.nc-home #heroLogo');
  const target = document.getElementById('leistungen');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let spinning = false;

  if (hero && logo && target) {
    // Restore the original coin movement, independently of the shared portrait tilt.
    if (window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
      hero.addEventListener('pointermove', event => {
        if (spinning || motion.matches) return;
        const rect = hero.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - .5;
        const y = (event.clientY - rect.top) / rect.height - .5;
        logo.style.transform = `perspective(900px) rotateX(${-y * 14}deg) rotateY(${x * 14}deg)`;
        logo.style.setProperty('--gx', `${50 + x * 46}%`);
        logo.style.setProperty('--gy', `${38 + y * 46}%`);
      });
      hero.addEventListener('pointerleave', () => {
        if (spinning) return;
        logo.style.transform = '';
        logo.style.setProperty('--gx', '50%');
        logo.style.setProperty('--gy', '35%');
      });
    }
    const goToServices = () => {
      target.scrollIntoView({ behavior: motion.matches ? 'instant' : 'smooth' });
      const heading = document.getElementById('services-title');
      heading?.focus({ preventScroll: true });
    };
    const spinAndGo = (event: Event) => {
      event.preventDefault();
      if (spinning) return;
      if (motion.matches) { goToServices(); return; }
      spinning = true;
      logo.style.transform = '';
      logo.classList.add('is-spinning');
      window.setTimeout(goToServices, 550);
      const stop = () => {
        logo.classList.remove('is-spinning');
        spinning = false;
        logo.removeEventListener('animationend', stop);
        window.clearTimeout(fallback);
      };
      const fallback = window.setTimeout(stop, 1500);
      logo.addEventListener('animationend', stop);
    };
    logo.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      spinAndGo(event);
    });
    logo.addEventListener('keydown', event => {
      if (event.key === ' ') spinAndGo(event);
    });
  }
</script>

<style>
  .home-typer{white-space:nowrap}
  .home-typer :global(.home-typer__marke){display:inline-block;width:2px;height:.9em;margin-left:.08em;vertical-align:-.08em;background:currentColor;animation:typer-blink 1s steps(1) infinite}
  .home-typer :global(.home-typer__marke.is-done){animation:typer-blink 1s steps(1) 3 forwards}
  @keyframes typer-blink{50%{opacity:0}}
  @media(prefers-reduced-motion:reduce){.home-typer :global(.home-typer__marke){display:none}}
</style>
