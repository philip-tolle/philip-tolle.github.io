---
// Einstieg in Stufen, nach Aufwand sortiert (Designkammer: galerie/maven).
const stufen = [
  { label: 'Klein anfangen', title: 'Erstgespräch', text: 'Kostenlos und unverbindlich. Bei Ihnen im Haus, digital oder am Telefon.', links: [{ t: 'Termin anfragen', h: '/kontakt/' }] },
  { label: 'Klarheit gewinnen', title: 'Ein ehrlicher Blick', text: 'Mystery Check, Digital Audit oder 30-Tage-Test. Festpreis, beim Folgeauftrag angerechnet.', links: [{ t: 'Mystery Check', h: '/management/mystery-check/' }, { t: 'Digital Audit', h: '/management/digital-audit/' }, { t: '30-Tage-Test', h: '/operation/30-tage-test/' }] },
  { label: 'Spürbar entlasten', title: 'Umsetzen', text: 'Betriebshandbuch, Monatspaket oder Training im Haus. Mit festem Preis, Umfang und Zeitplan.', links: [{ t: 'Betriebshandbuch', h: '/management/betriebshandbuch/' }, { t: 'Monatspakete', h: '/operation/monatspakete/' }, { t: 'Training', h: '/akademie/flying-academy/' }] },
];
---
<section class="home-approach home-stufen nc-section nc-shell nc-paper" aria-labelledby="approach-title">
  <div class="home-stufen__intro reveal">
    <p class="nc-kicker">So starten Sie</p>
    <h2 id="approach-title">Ein Schritt nach <em>dem anderen.</em></h2>
  </div>
  <ol class="home-stufen__list">
    {stufen.map((s, i) => (
      <li class="reveal" style={`--stufe:${i}`}>
        <span class="home-stufen__label"><span aria-hidden="true">{i + 1}</span>{s.label}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        <div class="home-stufen__links">{s.links.map(l => <a href={l.h}>{l.t} <span aria-hidden="true">→</span></a>)}</div>
      </li>
    ))}
  </ol>
</section>

<style>
  .home-stufen__intro{max-width:78rem;margin:0 auto 1.8rem}
  .home-stufen h2{color:var(--nc-forest);margin:0;font-size:clamp(2rem,3.4vw,3.4rem)}
  .home-stufen h2 em{font-family:Georgia,'Times New Roman',serif;font-weight:400;font-style:italic;color:#c4462b}
  .home-stufen__list{list-style:none;margin:0 auto;padding:0;max-width:78rem;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;align-items:end}
  .home-stufen__list li{padding:clamp(1.2rem,2vw,1.8rem);border-radius:16px;background:#fff;border:1px solid rgba(18,42,47,.14);color:var(--nc-forest);min-height:calc(13rem + var(--stufe) * 2.5rem);display:flex;flex-direction:column}
  .home-stufen__list li:last-child{background:var(--nc-forest);color:var(--nc-paper);border-color:var(--nc-forest)}
  .home-stufen__label{display:flex;align-items:center;gap:.6rem;font-size:.72rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#c4462b}
  .home-stufen__list li:last-child .home-stufen__label{color:#ff947a}
  .home-stufen__label span{display:grid;place-items:center;width:1.7rem;height:1.7rem;border-radius:50%;border:1.5px solid currentColor;font-size:.75rem;letter-spacing:0}
  .home-stufen__list h3{color:inherit;margin:.9rem 0 .4rem;font-size:clamp(1.3rem,1.8vw,1.8rem)}
  .home-stufen__list p{margin:0 0 1rem;color:inherit;opacity:.8;font-size:.9em;line-height:1.5}
  .home-stufen__links{margin-top:auto;display:flex;flex-wrap:wrap;gap:.2rem 1.1rem}
  .home-stufen__links a{display:inline-flex;align-items:center;gap:.4rem;min-height:44px;color:inherit;font-size:.85em;font-weight:600;text-underline-offset:.3em}
  .home-stufen__links a:focus-visible{outline:2px solid currentColor;outline-offset:3px}
  @media(max-width:799px){.home-stufen__list{grid-template-columns:1fr;gap:.7rem}.home-stufen__list li{min-height:0}}
</style>
