---
import { Image } from 'astro:assets';
import logo from '../assets/nc-logo.png';

const links = [
  { href: '/', label: 'Start', overlayLabel: 'Start' },
  { href: '/management/', label: 'Management', overlayLabel: 'Management' },
  { href: '/akademie/', label: 'Academy', overlayLabel: 'Academy' },
  { href: '/operation/', label: 'Operation', overlayLabel: 'Operation' },
  { href: '/blog/', label: 'Blog', overlayLabel: 'Blog' },
  { href: '/ueber/', label: 'Über', overlayLabel: 'Über NextCourse' },
  { href: '/kontakt/', label: 'Kontakt', overlayLabel: 'Kontakt' },
];
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const normalized = href.replace(/\/+$/, '') || '/';
  return normalized === current || (normalized !== '/' && current.startsWith(`${normalized}/`));
};
---
<header class="header" id="header">
  <div class="header__in">
    <a href="/" class="logo" aria-label="NextCourse Startseite">
      <span class="logo__mark" aria-hidden="true">
        <Image src={logo} alt="" width={96} format="webp" quality={82} loading="eager" />
      </span>
      <span class="logo__word">NextCourse</span>
    </a>
    <div class="header__actions">
      <nav class="nav" aria-label="Hauptnavigation">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[isActive(link.href) && 'is-active', link.href === '/kontakt/' && 'nav-contact']}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >{link.label}</a>
        ))}
      </nav>
      <button class="burger" aria-expanded="false" aria-label="Menü öffnen" aria-controls="overlay">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="overlay" id="overlay" aria-hidden="true" inert>
  {links.map((link) => (
    <a
      href={link.href}
      class:list={[isActive(link.href) && 'is-active']}
      aria-current={isActive(link.href) ? 'page' : undefined}
    >{link.overlayLabel}</a>
  ))}
</div>

<noscript>
  <nav class="noscript-nav" aria-label="Hauptnavigation ohne JavaScript">
    {links.map((link) => <a href={link.href}>{link.overlayLabel}</a>)}
  </nav>
</noscript>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const overlay = document.getElementById('overlay');
  const logo = document.querySelector<HTMLElement>('.logo');
  const backgroundRegions = [
    document.getElementById('main'),
    document.querySelector<HTMLElement>('footer'),
  ];

  const menuLinks = () => Array.from(overlay?.querySelectorAll<HTMLAnchorElement>('a') ?? []);

  function setMenu(open: boolean) {
    if (!burger || !overlay) { return; }
    overlay.classList.toggle('open', open);
    overlay.toggleAttribute('inert', !open);
    overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    burger.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    logo?.toggleAttribute('inert', open);
    backgroundRegions.forEach((region) => region?.toggleAttribute('inert', open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      requestAnimationFrame(() => menuLinks()[0]?.focus());
    }
  }

  burger?.addEventListener('click', () => {
    setMenu(!overlay?.classList.contains('open'));
  });

  overlay?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && overlay?.classList.contains('open')) {
      setMenu(false);
      burger?.focus();
      return;
    }

    if (event.key === 'Tab' && overlay?.classList.contains('open') && burger) {
      const focusable = [burger, ...menuLinks()];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
</script>
