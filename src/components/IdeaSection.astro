---
import Icon from './Icon.astro';
---

<div class="floor" id="idee" style="padding:5rem 0 1.6rem">
  <div class="wrap">
    <div class="menuhead">
      <p class="eyebrow eyebrow--c reveal" style="--acc:var(--wood)">Die Idee hinter NextCourse</p>
      <h2 class="reveal" style="font-size:clamp(1.8rem,4.2vw,2.7rem)">Kein Wissensproblem. Ein Zeitproblem.</h2>
    </div>

    <div class="idee2">
      <div class="idee2col reveal">
        <p class="eyebrow eyebrow--c" style="--acc:var(--amber)">Das Problem</p>
        <div class="idee2__viz">
          <div class="forces__stage" id="forces">
            <svg viewBox="0 0 520 320" preserveAspectRatio="none" aria-hidden="true">
              <path d="M256,31 C304,31 312,98 354,138"/>
              <path d="M256,111 C304,111 314,142 352,154"/>
              <path d="M256,191 C304,191 314,178 352,166"/>
              <path d="M256,271 C304,271 312,222 354,182"/>
            </svg>
            <div class="forces__pill" data-f="0" style="top:0">
              <span>Margendruck</span><b>sechs Verlustjahre in Folge</b>
            </div>
            <div class="forces__pill" data-f="1" style="top:80px">
              <span>Qualifikationsdefizit</span><b>KI-Wissen fehlt im Alltag</b>
            </div>
            <div class="forces__pill" data-f="2" style="top:160px">
              <span>Digitalisierungsrückstand</span><b>≈ 70 % analoge Prozesse</b>
            </div>
            <div class="forces__pill" data-f="3" style="top:240px">
              <span>Bürokratische Hürden</span><b>EU AI Act, DSGVO &amp; Co.</b>
            </div>
            <div class="zeitmuenze">
              <span>Es kostet vor allem</span>
              <b>Zeit</b>
              <span>die im Betrieb fehlt</span>
            </div>
          </div>
        </div>
      </div>
      <span class="idee2__div" aria-hidden="true"></span>
      <div class="idee2col reveal">
        <p class="eyebrow eyebrow--c" style="--acc:var(--green)">Unsere Antwort</p>
        <div class="idee2__viz">
          <div class="deck" id="deck">
            <div class="deckcard" data-pos="0" style="--dacc:var(--blue)">
              <span class="deckcard__ico" aria-hidden="true"><Icon name="ausbildung" size={30} /></span>
              <h3>Academy</h3>
              <p class="deckcard__verb">Lernen</p>
              <p class="deckcard__antwort">Weil Technik nur hilft, wenn Menschen sie verstehen. Wissen im Team macht unabhängig und spart vom ersten Tag an Zeit.</p>
            </div>
            <div class="deckcard" data-pos="1" style="--dacc:var(--green)">
              <span class="deckcard__ico" aria-hidden="true"><Icon name="ziel" size={30} /></span>
              <h3>Management</h3>
              <p class="deckcard__verb">Umsetzen</p>
              <p class="deckcard__antwort">Weil gute Systeme kein Zufall sind. Erst der ehrliche Blick, dann die messbare Umsetzung. Schritt für Schritt statt Großprojekt.</p>
            </div>
            <div class="deckcard" data-pos="2" style="--dacc:var(--amber)">
              <span class="deckcard__ico" aria-hidden="true"><Icon name="gastlichkeit" size={30} /></span>
              <h3>Operation</h3>
              <p class="deckcard__verb">Abgeben</p>
              <p class="deckcard__antwort">Weil manche Aufgaben gar nicht erst bei Ihnen landen müssen. Abgeben schafft sofort Luft, ohne eine neue Stelle zu besetzen.</p>
            </div>
          </div>
          <div class="deck__dots" aria-label="Bereich wählen">
            <button class="deck__dot is-on" data-i="0" style="--dc:var(--blue)" aria-label="Academy zeigen"></button>
            <button class="deck__dot" data-i="1" style="--dc:var(--green)" aria-label="Management zeigen"></button>
            <button class="deck__dot" data-i="2" style="--dc:var(--amber)" aria-label="Operation zeigen"></button>
          </div>
        </div>
      </div>
    </div>
    <a class="scrollhint" href="#profil" style="margin-top:.6rem" aria-label="Weiter zum Profil von Philip Tolle">
      <span class="hintword">Entdecken</span><span class="bar" aria-hidden="true"></span>
    </a>
  </div>
</div>

<script>
  const ideaReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ideaForces = document.getElementById('forces');
  const ideaPills = Array.from(document.querySelectorAll<HTMLElement>('.forces__pill'));
  let ideaActive = 0;
  let ideaPaused = false;
  let ideaTimer: ReturnType<typeof setInterval> | null = null;
  let ideaResume: ReturnType<typeof setTimeout> | null = null;

  const setIdeaForce = (i: number) => {
    if (!ideaForces || !ideaPills.length) { return; }
    ideaActive = (i + ideaPills.length) % ideaPills.length;
    ideaForces.dataset.active = String(ideaActive);
    ideaPills.forEach((pill, index) => pill.classList.toggle('is-active', index === ideaActive));
  };
  const holdIdeaForce = (ms = 4500) => {
    ideaPaused = true;
    if (ideaResume) { clearTimeout(ideaResume); }
    ideaResume = setTimeout(() => { ideaPaused = false; }, ms);
  };

  setIdeaForce(0);
  if (ideaForces && !ideaReduced && ideaPills.length) {
    const ideaObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !ideaTimer) {
          ideaTimer = setInterval(() => { if (!ideaPaused) { setIdeaForce(ideaActive + 1); } }, 2600);
        }
      });
    }, { threshold: .35 });
    ideaObserver.observe(ideaForces);
  }
  const ideaFinePointer = window.matchMedia('(pointer:fine)').matches;
  ideaPills.forEach((pill, index) => {
    if (ideaFinePointer) {
      pill.addEventListener('pointerenter', () => { ideaPaused = true; setIdeaForce(index); });
      pill.addEventListener('pointerleave', () => { ideaPaused = false; });
    }
    pill.addEventListener('click', () => { setIdeaForce(index); holdIdeaForce(); });
  });

  const ideaDeck = document.getElementById('deck');
  const ideaCards = ideaDeck ? Array.from(ideaDeck.querySelectorAll<HTMLElement>('.deckcard')) : [];
  const ideaDots = Array.from(document.querySelectorAll<HTMLButtonElement>('.deck__dot'));
  let ideaOrder = [0, 1, 2];
  let ideaTurning = false;

  function applyIdeaOrder() {
    ideaOrder.forEach((cardIndex, position) => { if (ideaCards[cardIndex]) { ideaCards[cardIndex].dataset.pos = String(position); } });
    ideaDots.forEach((dot, index) => dot.classList.toggle('is-on', ideaOrder[0] === index));
  }
  function advanceIdeaDeck() {
    if (ideaTurning || !ideaDeck || ideaCards.length < 3) { return; }
    ideaTurning = true;
    const top = ideaCards[ideaOrder[0]];
    if (ideaReduced) {
      ideaOrder.push(ideaOrder.shift()!);
      applyIdeaOrder();
      ideaTurning = false;
      return;
    }
    top.classList.add('is-leaving');
    setTimeout(() => {
      ideaOrder.push(ideaOrder.shift()!);
      applyIdeaOrder();
      top.classList.remove('is-leaving');
      ideaTurning = false;
    }, 480);
  }
  function retreatIdeaDeck() {
    if (ideaTurning || ideaCards.length < 3) { return; }
    ideaOrder.unshift(ideaOrder.pop()!);
    applyIdeaOrder();
  }
  ideaDots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const target = parseInt(dot.dataset.i!, 10);
      if (ideaOrder[0] === target || ideaTurning) { return; }
      ideaOrder = [target, (target + 1) % 3, (target + 2) % 3];
      applyIdeaOrder();
    });
  });

  if (ideaDeck) {
    let ideaSwiped = false;
    let ideaStartX = 0;
    let ideaStartY = 0;
    ideaDeck.addEventListener('pointerdown', (event) => { ideaStartX = event.clientX; ideaStartY = event.clientY; });
    ideaDeck.addEventListener('pointerup', (event) => {
      const dx = event.clientX - ideaStartX;
      const dy = event.clientY - ideaStartY;
      if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy)) {
        ideaSwiped = true;
        if (dx < 0) { advanceIdeaDeck(); } else { retreatIdeaDeck(); }
        setTimeout(() => { ideaSwiped = false; }, 350);
      }
    });
    ideaDeck.addEventListener('click', () => { if (!ideaSwiped) { advanceIdeaDeck(); } });
  }
</script>
