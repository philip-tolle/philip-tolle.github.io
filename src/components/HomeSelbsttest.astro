---
// Selbsttest zum Antippen (Designkammer: effekte/auswahlkarten). Aussagen gemischt, der Bereich mit den meisten Treffern wird empfohlen.
const bereiche = {
  management: { name: 'Management', claim: 'Abläufe ordnen', href: '/management/', topic: 'management' },
  academy: { name: 'Academy', claim: 'Team stärken', href: '/akademie/', topic: 'academy' },
  operation: { name: 'Operation', claim: 'Arbeit abgeben', href: '/operation/', topic: 'entlastung' },
};
const aussagen = [
  { b: 'management', text: 'Im Team tauchen dieselben Fragen immer wieder auf.' },
  { b: 'operation', text: 'Karten, Aushänge und Aktualisierungen binden viel Führungszeit.' },
  { b: 'academy', text: 'Neue Mitarbeitende und Aushilfen brauchen schnell Orientierung.' },
  { b: 'management', text: 'Etwas läuft nicht rund, aber die Ursache ist unklar.' },
  { b: 'operation', text: 'Für eine Stelle zu wenig, zum Liegenlassen zu viel.' },
  { b: 'academy', text: 'Für Schulungen fehlt im Alltag die Zeit.' },
];
---
<section class="home-test nc-section nc-shell nc-paper" id="selbsttest" aria-labelledby="test-title" data-selbsttest data-bereiche={JSON.stringify(bereiche)}>
  <div class="home-test__intro reveal">
    <p class="nc-kicker">Kurzer Selbsttest</p>
    <h2 id="test-title">Was trifft auf <em>Ihr Haus zu?</em></h2>
  </div>
  <ul class="home-test__grid">
    {aussagen.map((a, i) => (
      <li><label class="home-test__card"><input type="checkbox" name={`aussage-${i}`} value={a.b} /><span class="home-test__box" aria-hidden="true"></span><span>{a.text}</span></label></li>
    ))}
  </ul>
  <div class="home-test__result" aria-live="polite">
    <p data-test-text>Tippen Sie an, was zutrifft.</p>
    <a class="home-test__link" href="/kontakt/" data-test-link hidden>Bereich ansehen <span aria-hidden="true">→</span></a>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-selbsttest]');
  if (root) {
    const bereiche = JSON.parse(root.dataset.bereiche || '{}') as Record<string, { name: string; claim: string; href: string }>;
    const text = root.querySelector<HTMLElement>('[data-test-text]')!;
    const link = root.querySelector<HTMLAnchorElement>('[data-test-link]')!;
    root.addEventListener('change', () => {
      const counts: Record<string, number> = {};
      root.querySelectorAll<HTMLInputElement>('input:checked').forEach(i => { counts[i.value] = (counts[i.value] || 0) + 1; });
      const best = Object.entries(counts).sort((a, b) => b[1] - a[1])[0];
      if (!best) { text.textContent = 'Tippen Sie an, was zutrifft.'; link.hidden = true; return; }
      const b = bereiche[best[0]];
      text.innerHTML = `Ihr Einstieg: <strong>${b.name}</strong> · ${b.claim}`;
      link.href = b.href;
      link.innerHTML = `${b.name} ansehen <span aria-hidden="true">→</span>`;
      link.hidden = false;
    });
  }
</script>

<style>
  .home-test{padding-block:clamp(2.5rem,5vw,5rem)}
  .home-test__intro{max-width:78rem;margin:0 auto 1.6rem}
  .home-test__intro h2{color:var(--nc-forest);margin:0;font-size:clamp(2rem,3.4vw,3.4rem)}
  .home-test__intro h2 em{font-family:Georgia,'Times New Roman',serif;font-weight:400;font-style:italic;color:#c4462b}
  .home-test__grid{list-style:none;margin:0 auto;padding:0;max-width:78rem;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}
  .home-test__card{position:relative;display:grid;grid-template-columns:1.4rem minmax(0,1fr);gap:.8rem;align-items:start;height:100%;padding:1rem 1.1rem;border:1px solid rgba(18,42,47,.18);border-radius:14px;background:#fff;color:var(--nc-forest);font-size:.92em;line-height:1.45;cursor:pointer;transition:border-color .2s,background .2s}
  .home-test__card input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
  .home-test__box{display:grid;place-items:center;width:1.4rem;height:1.4rem;border:1.5px solid rgba(18,42,47,.5);border-radius:6px;background:#fff}
  .home-test__card:has(input:checked){border-color:var(--nc-forest);background:#eef2ef}
  .home-test__card:has(input:checked) .home-test__box{background:var(--nc-forest);border-color:var(--nc-forest)}
  .home-test__card:has(input:checked) .home-test__box::after{content:'';width:.42rem;height:.72rem;border:solid #fff;border-width:0 2px 2px 0;transform:translateY(-1px) rotate(45deg)}
  .home-test__card:has(input:focus-visible){outline:2px solid var(--nc-forest);outline-offset:2px}
  .home-test__result{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.6rem 1.5rem;max-width:78rem;margin:1.2rem auto 0;padding:1rem 1.2rem;border-radius:14px;background:var(--nc-forest);color:var(--nc-paper);min-height:3.6rem}
  .home-test__result p{margin:0;font-size:.95em}
  .home-test__result strong{color:#ff947a}
  .home-test__link{display:inline-flex;align-items:center;gap:.6rem;min-height:44px;color:var(--nc-paper);font-weight:600;font-size:.88em;text-underline-offset:.35em}
  .home-test__link[hidden]{display:none}
  .home-test__link:focus-visible{outline:2px solid #ff947a;outline-offset:4px}
  @media(max-width:899px){.home-test__grid{grid-template-columns:1fr 1fr}}
  @media(max-width:599px){.home-test__grid{grid-template-columns:1fr;gap:.5rem}.home-test__card{padding:.8rem .9rem;min-height:44px}}
  @media(prefers-reduced-motion:reduce){.home-test__card{transition:none}}
</style>
