---
// Booklet Seite 3 "Rechnen Sie einmal nach". Designkammer: effekte/zahlen-zum-anfassen (Hochzählen 1,4 s, tabular-nums).
const felder = [
  { id: 'stunden', label: 'Stunden pro Woche', min: 1, max: 40, step: 1, value: 5, einheit: 'Std.' },
  { id: 'satz', label: 'Kosten pro Stunde', min: 12, max: 60, step: 1, value: 25, einheit: '€' },
  { id: 'wochen', label: 'Wochen im Jahr', min: 1, max: 52, step: 1, value: 52, einheit: 'Wo.' },
  { id: 'personen', label: 'Betroffene Personen', min: 1, max: 20, step: 1, value: 1, einheit: 'Pers.' },
];
---
<div class="rechner reveal" id="rechnen" data-rechner>
  <div class="rechner__copy">
    <p class="rechner__kicker">Rechnen Sie einmal nach.</p>
    <p class="rechner__formel" data-formel>5 Stunden pro Woche × 25 € pro Stunde × 52 Wochen</p>
    <output class="rechner__ergebnis" data-ergebnis aria-live="polite">= <span data-zahl>6.500</span> € pro Jahr</output>
    <p class="rechner__hinweis">Zeitverlust durch Einarbeitung, Informationssuche, Rückfragen, doppelte Pflege und offene Übergaben. <strong data-personen-text>Für eine Person.</strong> Setzen Sie gern Ihre eigenen Werte ein.</p>
    <p class="rechner__schluss">Und das ist nur einer der Preise, die Inhaber zahlen. Dazu kommen verlorene Buchungen, Bewerbungen, Fehler und die eigene Zeit.</p>
  </div>
  <form class="rechner__regler" aria-label="Eigene Werte einsetzen" data-regler>
    {felder.map(f => (
      <label class="rechner__feld" for={`r-${f.id}`}>
        <span class="rechner__label">{f.label}<strong data-wert={f.id}>{f.value} {f.einheit}</strong></span>
        <input type="range" id={`r-${f.id}`} name={f.id} min={f.min} max={f.max} step={f.step} value={f.value} data-einheit={f.einheit} />
      </label>
    ))}
  </form>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-rechner]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-regler]')!;
    const zahl = root.querySelector<HTMLElement>('[data-zahl]')!;
    const formel = root.querySelector<HTMLElement>('[data-formel]')!;
    const personenText = root.querySelector<HTMLElement>('[data-personen-text]')!;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const fmt = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 });
    const inputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[type="range"]'));
    const value = (name: string) => Number(form.querySelector<HTMLInputElement>(`[name="${name}"]`)!.value);
    let shown = 0;
    let frame = 0;
    const animateTo = (target: number, duration: number) => {
      cancelAnimationFrame(frame);
      if (motion.matches || duration === 0) { shown = target; zahl.textContent = fmt.format(target); return; }
      const start = shown;
      const t0 = performance.now();
      const step = (now: number) => {
        const u = Math.min(1, (now - t0) / duration);
        shown = start + (target - start) * (1 - Math.pow(1 - u, 3));
        zahl.textContent = fmt.format(Math.round(shown));
        if (u < 1) frame = requestAnimationFrame(step);
      };
      frame = requestAnimationFrame(step);
    };
    const total = () => value('stunden') * value('satz') * value('wochen') * value('personen');
    const update = (duration = 450) => {
      inputs.forEach(i => { const out = root.querySelector<HTMLElement>(`[data-wert="${i.name}"]`); if (out) out.textContent = `${i.value} ${i.dataset.einheit}`; });
      const p = value('personen');
      formel.textContent = `${value('stunden')} Stunden pro Woche × ${value('satz')} € pro Stunde × ${value('wochen')} Wochen${p > 1 ? ` × ${p} Personen` : ''}`;
      personenText.textContent = p > 1 ? `Für ${p} Personen.` : 'Für eine Person.';
      animateTo(total(), duration);
    };
    form.addEventListener('input', () => update());
    form.addEventListener('submit', e => e.preventDefault());
    // Beim ersten Sichtbarwerden einmal von 0 hochzählen.
    zahl.textContent = fmt.format(total());
    shown = total();
    if (!motion.matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        if (entries.some(e => e.isIntersecting)) { shown = 0; zahl.textContent = '0'; animateTo(total(), 1400); io.disconnect(); }
      }, { threshold: .5 });
      io.observe(root);
    }
  }
</script>

<style>
  .rechner{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(2rem,5vw,5rem);align-items:center;max-width:72rem;margin:clamp(1rem,3vw,3rem) auto 0;padding:clamp(1.6rem,4vw,3.5rem);border-radius:18px;background:var(--nc-forest);color:var(--nc-paper)}
  .rechner__kicker{font-weight:700;font-size:1.15em;margin:0 0 .6rem}
  .rechner__formel{color:#c6d0ce;margin:0;font-size:.95em}
  .rechner__ergebnis{display:block;font-family:var(--disp);font-weight:800;letter-spacing:-.04em;font-size:clamp(2.4rem,5vw,4.4rem);line-height:1.1;margin:.6rem 0 1rem;font-variant-numeric:tabular-nums}
  .rechner__hinweis{color:#c6d0ce;font-size:.85em;margin:0 0 1.2rem;max-width:52ch}
  .rechner__hinweis strong{color:var(--nc-paper)}
  .rechner__schluss{font-family:Georgia,'Times New Roman',serif;font-style:italic;color:#ff947a;margin:0;padding-top:1.1rem;border-top:3px solid #ff6b4a;max-width:52ch}
  .rechner__regler{display:grid;gap:1.4rem}
  .rechner__feld{display:grid;gap:.55rem}
  .rechner__label{display:flex;justify-content:space-between;gap:1rem;font-size:.85em;color:#c6d0ce}
  .rechner__label strong{color:var(--nc-paper);font-variant-numeric:tabular-nums;white-space:nowrap}
  .rechner__feld input{width:100%;accent-color:#ff6b4a;min-height:44px;cursor:pointer}
  .rechner__feld input:focus-visible{outline:2px solid #ff6b4a;outline-offset:4px}
  @media(max-width:799px){.rechner{grid-template-columns:1fr}}
</style>
