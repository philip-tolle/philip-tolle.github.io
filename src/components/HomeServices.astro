---
import { Image } from 'astro:assets';
import { situations } from '../data/home-services';
import MobileRailControls from './MobileRailControls.astro';
---
<section class="home-finder nc-section nc-shell" id="leistungen" data-wave-tone="dark" aria-labelledby="services-title">
  <div class="home-finder__intro">
    <div class="home-finder__heading">
      <p class="nc-kicker">Nicht alles auf einmal.<br />Das Richtige zuerst.</p>
      <h2 id="services-title" tabindex="-1">Was würde Ihren Alltag gerade leichter machen?</h2>
    </div>
    <div class="home-finder__choices" aria-label="Ihre aktuelle Aufgabe">
      {situations.map(situation => <a id={`${situation.id}-tab`} class="home-finder__choice" href={`#${situation.id}`} data-service-choice={situation.id}>
        <span class="home-finder__marker" aria-hidden="true"></span><span class="home-finder__choice-copy"><strong>{situation.short}</strong><small>{situation.guide}</small></span><span class="home-finder__arrow" aria-hidden="true">→</span>
      </a>)}
    </div>
    <div class="home-finder__mobile" data-mobile-rail>
      <div class="home-finder__mobile-track" data-mobile-rail-track tabindex="0" aria-label="Angebote: horizontal wischen oder mit den Pfeiltasten bewegen">
        {situations.map((situation) => <article class="home-finder__mobile-card" id={`mobile-${situation.id}`} data-mobile-rail-card>
          <a href={situation.href} aria-labelledby={`mobile-${situation.id}-heading`}>
            <div class="home-finder__mobile-image">
              <Image src={situation.image} alt={situation.imageAlt} width={720} widths={[360, 480, 720]} sizes="(max-width: 599px) 75vw, 1px" format="webp" quality={82} loading="lazy" decoding="async" />
            </div>
            <div class="home-finder__mobile-copy">
              <span>NextCourse · {situation.area}</span>
              <h3 id={`mobile-${situation.id}-heading`}>{situation.short}</h3>
              <p>{situation.mobileSummary}</p>
              <strong>{situation.action} <span aria-hidden="true">↗</span></strong>
            </div>
          </a>
        </article>)}
      </div>
      <MobileRailControls count={situations.length} noun="Angebote" />
    </div>
    <p class="home-finder__invitation">Noch unsicher, welcher Bereich passt?<br /><a href="/kontakt/">Den Einstieg gemeinsam finden <span aria-hidden="true">↗</span></a></p>
  </div>
  <div class="home-finder__results">
    {situations.map(situation => <article class="home-finder__result" id={situation.id} data-service-result aria-labelledby={`${situation.id}-heading`}>
      <a class="home-finder__card" href={situation.href} aria-labelledby={`${situation.id}-action`} aria-describedby={`${situation.id}-heading`}>
        <div class="home-finder__illustration">
          <Image
            src={situation.image}
            alt={situation.imageAlt}
            width={1400}
            widths={[480, 720, 1000, 1400]}
            sizes="(max-width: 999px) 90vw, 48vw"
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
          />
          <span class="home-finder__image-label">{situation.situation}</span>
        </div>
        <div class="home-finder__caption">
          <div class="home-finder__copy">
            <span class="home-finder__area">NextCourse · {situation.area}</span>
            <h3 id={`${situation.id}-heading`}>{situation.heading} <em>{situation.emphasis}</em></h3>
            <p class="home-finder__description">{situation.description}</p>
          </div>
          <span class="home-finder__action" id={`${situation.id}-action`}>{situation.action} <span class="home-finder__enter" aria-hidden="true">↗</span></span>
        </div>
      </a>
    </article>)}
  </div>
</section>

<script>
  const finder = document.querySelector<HTMLElement>('.home-finder');
  if (finder) {
    const choices = [...finder.querySelectorAll<HTMLAnchorElement>('[data-service-choice]')];
    const panels = [...finder.querySelectorAll<HTMLElement>('[data-service-result]')];
    const tablist = finder.querySelector<HTMLElement>('.home-finder__choices')!;
    tablist.setAttribute('role', 'tablist');
    tablist.setAttribute('aria-orientation', 'vertical');
    choices.forEach(choice => {
      choice.setAttribute('role', 'tab');
      choice.setAttribute('aria-controls', choice.dataset.serviceChoice!);
    });
    panels.forEach(panel => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', `${panel.id}-tab`);
      panel.tabIndex = 0;
    });
    function select(id: string, focus = false) {
      if (!panels.some(panel => panel.id === id)) return;
      choices.forEach(choice => {
        const selected = choice.dataset.serviceChoice === id;
        choice.setAttribute('aria-selected', String(selected));
        choice.tabIndex = selected ? 0 : -1;
        if (selected && focus) choice.focus({ preventScroll: true });
      });
      panels.forEach(panel => panel.hidden = panel.id !== id);
    }
    function activate(index: number, focus = false) {
      const id = choices[index].dataset.serviceChoice!;
      select(id, focus);
      history.replaceState(null, '', `#${id}`);
    }
    choices.forEach((choice, index) => {
      choice.addEventListener('click', event => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        activate(index);
      });
      choice.addEventListener('keydown', event => {
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        const last = choices.length - 1;
        const next = ['ArrowDown', 'ArrowRight'].includes(event.key) ? (index + 1) % choices.length
          : ['ArrowUp', 'ArrowLeft'].includes(event.key) ? (index + last) % choices.length
          : event.key === 'Home' ? 0 : event.key === 'End' ? last
          : event.key === ' ' ? index : undefined;
        if (next === undefined) return;
        event.preventDefault();
        activate(next, true);
      });
    });
    const requested = location.hash.slice(1);
    select(panels.some(panel => panel.id === requested) ? requested : panels[0].id);
    window.addEventListener('hashchange', () => select(location.hash.slice(1)));
  }
</script>
