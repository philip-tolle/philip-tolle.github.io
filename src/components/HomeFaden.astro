---
// Die Coral-Linie aus dem Booklet läuft beim Scrollen durch die Startseite (Designkammer: effekte/objekt-folgt-pfad).
// Ein Punkt fährt mit, hinter ihm füllt sich die Linie, jede Abschnittsüberschrift ist eine Station.
---
<div class="home-faden" data-faden>
  <slot />
  <div class="home-faden__line" aria-hidden="true"><span class="home-faden__track"></span><span class="home-faden__fill"></span><span class="home-faden__dot"></span></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-faden]');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (root) {
    const line = root.querySelector<HTMLElement>('.home-faden__line')!;
    const fill = root.querySelector<HTMLElement>('.home-faden__fill')!;
    const dot = root.querySelector<HTMLElement>('.home-faden__dot')!;
    let stations: HTMLElement[] = [];
    const place = () => {
      stations.forEach(s => s.remove());
      const top = root.getBoundingClientRect().top + scrollY;
      stations = Array.from(root.querySelectorAll<HTMLElement>('h2')).map(h => {
        const s = document.createElement('span');
        s.className = 'home-faden__station';
        s.style.top = `${h.getBoundingClientRect().top + scrollY - top + 12}px`;
        line.appendChild(s);
        return s;
      });
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = root.getBoundingClientRect();
      const marker = innerHeight * .55;
      const progress = motion.matches ? 1 : Math.min(1, Math.max(0, (marker - rect.top) / rect.height));
      const y = progress * rect.height;
      fill.style.transform = `scaleY(${progress})`;
      dot.style.transform = `translate(-50%, ${y}px)`;
      stations.forEach(s => s.classList.toggle('is-reached', parseFloat(s.style.top) <= y));
    };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    place();
    update();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', () => { place(); request(); });
    window.addEventListener('load', () => { place(); request(); });
  }
</script>

<style>
  .home-faden{position:relative}
  .home-faden__line{position:absolute;top:0;bottom:0;left:calc(var(--nc-gutter) / 2);width:0;z-index:3;pointer-events:none}
  .home-faden__track,.home-faden__fill{position:absolute;top:0;bottom:0;left:-1px;width:2px;border-radius:2px}
  .home-faden__track{background:rgba(255,107,74,.22)}
  .home-faden__fill{background:#ff6b4a;transform-origin:top;transform:scaleY(0)}
  .home-faden__dot{position:absolute;top:-7px;left:0;width:14px;height:14px;border-radius:50%;background:#ff6b4a;box-shadow:0 0 0 4px rgba(255,107,74,.25);transform:translate(-50%,0)}
  .home-faden__line :global(.home-faden__station){position:absolute;left:0;width:10px;height:10px;border-radius:50%;border:2px solid #ff6b4a;background:var(--nc-paper);transform:translate(-50%,-50%);transition:background .3s}
  .home-faden__line :global(.home-faden__station.is-reached){background:#ff6b4a}
  @media(max-width:599px){.home-faden__line{left:.55rem}.home-faden__dot{width:12px;height:12px}}
  @media(prefers-reduced-motion:reduce){.home-faden__dot{display:none}.home-faden__line :global(.home-faden__station){transition:none}}
</style>
