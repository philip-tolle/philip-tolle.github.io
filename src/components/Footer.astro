---
import { wege, kontakt } from '../data/wege';
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <span class="fw">NextCourse</span><br />
        <span class="claim">Zuhören. Möglichkeiten erkennen. Umsetzen.</span>
        <p class="faint small" style="margin-top:1rem">Wir setzen um, wofür im Alltag die Zeit fehlt. Für inhabergeführte Hotels und Gastronomie in Mainfranken.</p>
      </div>
      <div>
        <h4>Vier Wege</h4>
        <ul>
          {wege.map((weg) => <li><a href={weg.href}>{weg.title}</a></li>)}
          <li><a href="/preise/">Preise und Förderung</a></li>
          <li><a href="/faq/">Häufige Fragen</a></li>
          <li><a href="/prompt-studio/">Prompt Studio</a></li>
        </ul>
      </div>
      <div>
        <h4>Unternehmen</h4>
        <ul>
          <li><a href="/ueber/">Über NextCourse</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
          <li><a href="https://www.linkedin.com/in/philiptolle/" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
      <div>
        <h4>Rechtliches</h4>
        <ul>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__base">
      <span>© <span id="year"></span> NextCourse UG (haftungsbeschränkt) · Würzburg</span>
      <span>
        <a href="tel:+4915120220983">+49 151 20220983</a> ·
        <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
      </span>
    </div>
  </div>
</footer>
