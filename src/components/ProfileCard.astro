---
import { Image } from 'astro:assets';
import philip from '../assets/philip.png';

const qualifications = [
  'Gelernter Hotelfachmann',
  'Staatlich geprüfter Restaurantmeister (IHK)',
  'Staatlich geprüfter Betriebswirt für Hotellerie & Gastronomie',
  'Sommelier',
  'Ausbildereignung (IHK)',
  'Barista Skills Foundation',
];
---
<figure class="profile-card" data-profile-card>
  <div class="profile-card__faces">
    <div class="profile-card__face profile-card__front" id="profile-photo" data-profile-face="photo">
      <button type="button" class="profile-card__photo" data-profile-show="qualifications" aria-controls="profile-qualifications" aria-expanded="false" aria-label="Foto umdrehen: Stationen und Abschlüsse von Philip Tolle" disabled>
        <Image src={philip} alt="Philip Tolle, Gründer und Geschäftsführer von NextCourse" widths={[400,700]} width={700} format="webp" loading="eager"/>
        <span class="profile-card__hint">Stationen &amp; Abschlüsse <span aria-hidden="true">↔</span></span>
      </button>
    </div>
    <section class="profile-card__face profile-card__back" id="profile-qualifications" data-profile-face="qualifications" aria-labelledby="profile-qualifications-title">
      <p class="profile-card__eyebrow">Philip Tolle</p>
      <h3 id="profile-qualifications-title">Stationen <em>&amp; Abschlüsse.</em></h3>
      <ul>{qualifications.map(qualification => <li>{qualification}</li>)}</ul>
      <button type="button" class="profile-card__return" data-profile-show="photo" aria-controls="profile-photo" hidden><span>Zurück zum Bild</span><span aria-hidden="true">↔</span></button>
    </section>
  </div>
  <figcaption>Philip Tolle · Gründer von NextCourse</figcaption>
</figure>

<style>
  .profile-card{margin:0;max-width:20rem;justify-self:center;width:100%;min-width:0;perspective:1200px}
  .profile-card__faces{position:relative}
  .profile-card__face{min-width:0;border:1px solid #122a2f20;border-radius:10px;overflow:hidden;box-shadow:0 16px 32px -22px #122a2f80}
  .profile-card__photo{display:block;position:relative;width:100%;height:100%;min-height:26rem;padding:0;border:0;background:#122a2f;color:#fff;appearance:none;cursor:pointer;font:inherit;text-align:left}
  .profile-card__photo:disabled{cursor:default}
  .profile-card__photo img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:center 25%}
  .profile-card__hint{position:absolute;bottom:0;left:0;width:100%;display:flex;align-items:center;justify-content:space-between;gap:.7rem;padding:2.5rem 1.2rem 1rem;background:linear-gradient(transparent,#122a2fe8);font-size:.8rem;font-weight:500}
  .profile-card__hint>span{display:grid;place-items:center;width:2.75rem;height:2.75rem;flex:none;border:1px solid #ffffff70;border-radius:50%;font-size:1.3rem;transition:background .2s}
  .profile-card__photo:hover .profile-card__hint>span{background:#ffffff20}
  .profile-card__photo:disabled .profile-card__hint{display:none}
  .profile-card__back{display:flex;flex-direction:column;padding:1.4rem;background:#122a2f;color:#f9f7f3;margin-top:1rem}
  :global(.detail-page) .profile-card .profile-card__eyebrow{margin:0 0 .7rem;color:#c6d0ce;font-size:.65rem;letter-spacing:.12em;text-transform:uppercase}
  :global(.detail-page) .profile-card h3{margin:0;font-size:1.45rem;color:#f9f7f3;line-height:1.2}
  .profile-card h3 em{display:block;font-family:Georgia,'Times New Roman',serif;font-weight:400;color:#ff947a}
  .profile-card ul{list-style:none;padding:0;margin:1rem 0 1.25rem}
  .profile-card li{font-size:.82rem;line-height:1.5;padding:.55rem 0;border-bottom:1px solid #f9f7f330}
  .profile-card__return{display:inline-flex;align-items:center;justify-content:center;gap:.75rem;align-self:flex-start;margin-top:auto;min-height:44px;padding:.6rem 1rem;border:1px solid #f9f7f360;border-radius:999px;background:transparent;color:inherit;font:500 .8rem/1.4 var(--body);cursor:pointer;transition:background .2s}
  .profile-card__return[hidden]{display:none}
  .profile-card__return:hover{background:#ffffff15}
  .profile-card__return>span[aria-hidden]{font-size:1.25rem}
  .profile-card button:focus-visible{outline:2px solid #ff947a;outline-offset:-6px}
  .profile-card figcaption{font-size:.72rem;line-height:1.6;color:#526368;margin-top:.75rem}
  /* Both faces determine the height, so qualifications never need an inner scrollbar. */
  .profile-card[data-ready] .profile-card__faces{display:grid;transform-style:preserve-3d;transition:transform .5s ease}
  .profile-card[data-ready] .profile-card__face{grid-area:1/1;margin:0;backface-visibility:hidden;-webkit-backface-visibility:hidden}
  .profile-card[data-ready] .profile-card__back{transform:rotateY(180deg)}
  .profile-card[data-side="qualifications"] .profile-card__faces{transform:rotateY(180deg)}
  .profile-card[data-ready] .profile-card__face[aria-hidden="true"]{pointer-events:none}
  @media(prefers-reduced-motion:reduce){.profile-card[data-ready] .profile-card__faces{transition:none}.profile-card__return,.profile-card__hint>span{transition:none}}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-profile-card]').forEach(card => {
    const faces = Array.from(card.querySelectorAll<HTMLElement>('[data-profile-face]'));
    const controls = Array.from(card.querySelectorAll<HTMLButtonElement>('[data-profile-show]'));
    const show = (side: string, focus = true) => {
      if (side !== 'photo' && side !== 'qualifications') return;
      card.dataset.side = side;
      faces.forEach(face => {
        const active = face.dataset.profileFace === side;
        face.inert = !active;
        face.setAttribute('aria-hidden', String(!active));
      });
      card.querySelector('[data-profile-show="qualifications"]')?.setAttribute('aria-expanded', String(side === 'qualifications'));
      if (focus) card.querySelector<HTMLButtonElement>(`[data-profile-face="${side}"] button`)?.focus({ preventScroll: true });
    };
    controls.forEach(control => {
      control.disabled = false;
      control.hidden = false;
      control.addEventListener('click', () => show(control.dataset.profileShow!));
    });
    card.dataset.ready = 'true';
    show('photo', false);
    card.addEventListener('keydown', event => {
      if (event.key === 'Escape' && card.dataset.side === 'qualifications') {
        event.preventDefault();
        show('photo');
      }
    });
  });
</script>
