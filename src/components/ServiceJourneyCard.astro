---
import { Image } from 'astro:assets';
import type { JourneyStep } from '../data/service-pages';
interface Props { step: JourneyStep; area: string; }
const { step, area } = Astro.props;
const headingId = `format-${step.id}-heading`;
const coverId = `format-${step.id}-cover`;
const descriptionId = `format-${step.id}-description`;
---
<a class="service-mobile-card" href={step.href} data-mobile-service-link>
  <div class="service-mobile-card__image">
    <Image src={step.image.src} alt={step.image.alt} width={720} widths={[360, 480, 720]} sizes="(max-width: 599px) calc(100vw - 40px), 1px" format="webp" quality={82} loading="lazy" decoding="async" />
  </div>
  <div class="service-mobile-card__body">
    <p class="service-mobile-card__meta">NextCourse {area}{step.status && <span>{step.status}</span>}</p>
    <h3>{step.label}</h3>
    <p data-mobile-service-summary>{step.mobileSummary}</p>
    <strong>{step.action} <span aria-hidden="true">↗</span></strong>
  </div>
</a>
<div class="service-step" data-service-deck data-side="cover">
  <div class="service-card service-card--cover" data-deck-face="cover" id={coverId}>
    <div class="service-card__inner">
      <button class="service-step__image" type="button" data-deck-image data-deck-show="description" aria-label={`Beschreibung zu ${step.label} ansehen`} aria-controls={descriptionId} aria-expanded="false" disabled>
        <Image src={step.image.src} alt={step.image.alt} width={1400} widths={[480, 720, 1000, 1400]} sizes="(max-width: 859px) calc(100vw - 96px), 44vw" format="webp" quality={85} loading="lazy" decoding="async" />
      </button>
      <div class="service-step__body">
        <div class="service-step__meta"><span>NextCourse {area}</span>{step.status && <span class="service-step__status">{step.status}</span>}</div>
        <h3 id={headingId} tabindex="-1" data-deck-heading>{step.label}</h3>
        <p class="service-step__claim">{step.title} {step.emphasis}</p>
        <div class="service-step__controls">
          <button type="button" class="service-step__toggle" data-deck-show="description" aria-controls={descriptionId} aria-expanded="false" hidden><span>Details<span class="service-step__toggle-long"> ansehen</span></span><span aria-hidden="true">↔</span></button>
          {step.href && <a class="service-step__direct" href={step.href} aria-label={step.action}>{area === 'Operation' ? 'Zur Leistung' : 'Zum Angebot'} <span class="service-step__circle" aria-hidden="true">↗</span></a>}
        </div>
        <p class="service-step__swipe" aria-hidden="true">Bild &amp; Details <span>↔ Wischen</span></p>
      </div>
    </div>
  </div>
  <section class="service-card service-card--description" data-deck-face="description" id={descriptionId} aria-label={`${step.label}: Beschreibung und Leistungen`} hidden>
    <div class="service-card__inner service-step__body">
      <div class="service-step__backline"><span>{step.label}</span></div>
      <p class="service-step__situation">{step.situation}</p>
      <h4 class="service-step__benefit" tabindex="-1" data-deck-heading>{step.title} <em>{step.emphasis}</em></h4>
      <p class="service-step__description">{step.description}</p>
      <p class="service-step__label">{step.listLabel ?? 'Das nehmen Sie mit'}</p>
      <ul class="service-step__points">{step.points.map(point => <li>{point}</li>)}</ul>
      {step.offers && <div class="service-step__offers">{step.offers.map(offer => <a href={offer.href}>
        <h5>{offer.title}</h5><p>{offer.description}</p><span>{offer.action} <span aria-hidden="true">↗</span></span>
      </a>)}</div>}
      <div class="service-step__controls">
        <button type="button" class="service-step__toggle" data-deck-show="cover" aria-controls={coverId} hidden><span>Zurück zum Bild</span><span aria-hidden="true">↔</span></button>
        {step.href && <a class="service-step__direct" href={step.href} aria-label={step.action}>{area === 'Operation' ? 'Zur Leistung' : 'Zum Angebot'} <span class="service-step__circle" aria-hidden="true">↗</span></a>}
      </div>
      {step.note && <p class="service-step__note">{step.note}</p>}
    </div>
  </section>
</div>
<noscript><style>.service-card--description[hidden]{display:block!important;margin-top:1rem}.service-step__swipe{display:none!important}</style></noscript>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-service-deck]').forEach(deck => {
    const faces = Array.from(deck.querySelectorAll<HTMLElement>('[data-deck-face]'));
    const controls = Array.from(deck.querySelectorAll<HTMLButtonElement>('[data-deck-show]'));
    let sizeFrame = 0;
    let suppressedClickUntil = 0;
    let gesture: { id: number; x: number; y: number; time: number } | null = null;

    const syncHeight = () => {
      cancelAnimationFrame(sizeFrame);
      sizeFrame = requestAnimationFrame(() => {
        const inner = deck.querySelector<HTMLElement>(`[data-deck-face="${deck.dataset.side}"] .service-card__inner`)!;
        const height = Math.ceil(inner.getBoundingClientRect().height) + 2;
        if (deck.style.height !== `${height}px`) {
          deck.style.height = `${height}px`;
          window.dispatchEvent(new Event('resize'));
        }
      });
    };
    const showFace = (side: string, moveFocus = true) => {
      if (side !== 'cover' && side !== 'description') return;
      deck.dataset.side = side;
      for (const face of faces) {
        const active = face.dataset.deckFace === side;
        face.inert = !active;
        face.setAttribute('aria-hidden', String(!active));
      }
      controls.filter(control => control.dataset.deckShow === 'description').forEach(control => control.setAttribute('aria-expanded', String(side === 'description')));
      syncHeight();
      if (moveFocus) {
        deck.querySelector<HTMLElement>(`[data-deck-face="${side}"] [data-deck-heading]`)?.focus({ preventScroll: true });
        const top = deck.getBoundingClientRect().top;
        if (top < 96) window.scrollBy({ top: top - 96, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      }
    };

    controls.forEach(control => {
      control.hidden = false;
      control.disabled = false;
      control.addEventListener('click', () => showFace(control.dataset.deckShow!));
    });
    deck.dataset.deckReady = 'true';
    faces.forEach(face => { face.hidden = false; });
    showFace('cover', false);
    const observer = new ResizeObserver(syncHeight);
    faces.forEach(face => observer.observe(face.querySelector('.service-card__inner')!));

    deck.addEventListener('keydown', event => {
      const next = event.key === 'ArrowRight' ? 'description' : event.key === 'ArrowLeft' || event.key === 'Escape' ? 'cover' : null;
      if (next && next !== deck.dataset.side) { event.preventDefault(); showFace(next); }
    });
    // Horizontal gestures change the card only. Vertical page scrolling stays native.
    deck.addEventListener('pointerdown', event => {
      if (event.pointerType !== 'touch' || !event.isPrimary) return;
      if ((event.target as Element).closest('a, button:not([data-deck-image])')) return;
      gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, time: performance.now() };
      deck.setPointerCapture(event.pointerId);
    }, { passive: true });
    deck.addEventListener('pointerup', event => {
      if (!gesture || gesture.id !== event.pointerId) return;
      const dx = event.clientX - gesture.x;
      const dy = event.clientY - gesture.y;
      if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.4 && performance.now() - gesture.time < 900) {
        suppressedClickUntil = performance.now() + 400;
        showFace(dx < 0 ? 'description' : 'cover');
      }
      gesture = null;
    });
    deck.addEventListener('pointercancel', () => { gesture = null; });
    deck.addEventListener('click', event => {
      if (performance.now() < suppressedClickUntil) { event.preventDefault(); event.stopPropagation(); }
    }, true);
  });
</script>
