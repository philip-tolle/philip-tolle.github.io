---
const steps = [
  {
    number: '01',
    title: 'Klären',
    text: 'Wir grenzen Ziel, Bereiche, Ansprechpartner und die 40 relevanten Standards gemeinsam ab.',
    result: 'Klarer Projektumfang',
  },
  {
    number: '02',
    title: 'Vor Ort aufnehmen',
    text: 'An zwei Vor-Ort-Tagen sprechen wir mit den Verantwortlichen und nehmen reale Abläufe strukturiert auf.',
    result: 'Betriebswissen wird sichtbar',
  },
  {
    number: '03',
    title: 'Bauen und abstimmen',
    text: 'Aus Notizen entstehen Standards, Bildanweisungen, Zugänge und Toolkits. Zwei Korrekturrunden sind eingeplant.',
    result: 'Prüffähige Handbuchfassung',
  },
  {
    number: '04',
    title: 'Einführen und stabilisieren',
    text: 'Wir schulen die Nutzung und begleiten die Anwendung nach der Einführung 30 Tage lang im vereinbarten Umfang.',
    result: 'Ein System für den Alltag',
  },
];
---

<section class="landing-section landing-process" id="ablauf" aria-labelledby="process-title">
  <div class="landing-shell">
    <header class="landing-section__head" data-reveal>
      <p class="landing-index">Projektverlauf <span>04</span></p>
      <h2 id="process-title">Vom Erfahrungswissen zum eingeführten System.</h2>
      <p>
        Kein Handbuch von der Stange. Der Aufbau folgt Ihrem Betrieb –
        und einem klaren Weg von der ersten Klärung bis zur sicheren Anwendung.
      </p>
    </header>

    <ol class="process-line" aria-label="Vier Schritte zum digitalen Betriebshandbuch">
      {steps.map((step, index) => (
        <li data-reveal>
          <div class="process-line__marker" aria-hidden="true">
            <span>{step.number}</span>
            {index === steps.length - 1 && <i>●</i>}
          </div>
          <article>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <span class="process-line__result">{step.result}</span>
          </article>
        </li>
      ))}
    </ol>

    <p class="process-duration" data-reveal>
      <span>Orientierungsrahmen</span>
      <strong>8–10 Wochen</strong>
      <small>Bei rechtzeitiger Mitwirkung und Freigabe durch die benannten Ansprechpartner.</small>
    </p>
  </div>
</section>
