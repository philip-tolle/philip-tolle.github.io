---
import { Image } from 'astro:assets';
import logo from '../assets/nc-logo.png';
import ServiceJourneyCard from './ServiceJourneyCard.astro';
import MobileRailControls from './MobileRailControls.astro';
import type { ServicePageContent } from '../data/service-pages';
interface Props { page: ServicePageContent; }
const { page } = Astro.props;
---
<section class="service-journey service-shell" id={`${page.id}-angebote`} aria-labelledby="service-journey-title">
  <span id="weg" class="service-anchor" aria-hidden="true"></span>
  <div class="service-section-intro">
    <div><p class="service-kicker">{page.journey.kicker}</p><h2 id="service-journey-title">{page.journey.heading} <em>{page.journey.emphasis}</em></h2></div>
    <p class="desktop-overview-copy">{page.journey.intro}</p>
    <p class="mobile-overview-copy" data-mobile-journey-intro>{page.journey.mobileIntro}</p>
  </div>
  <nav class="service-jumps" aria-label={`${page.area}: direkt zum Angebot`}>
    {page.journey.steps.map(step => <a href={`#format-${step.id}`}>{step.label}<span aria-hidden="true">↓</span></a>)}
    {page.journey.links?.map(link => <a href={link.href}>{link.label}<span aria-hidden="true">↓</span></a>)}
  </nav>
  {page.id === 'management' && <a class="service-start" href={`/kontakt/?thema=${page.topic}#contactform`}><span>Der erste Schritt</span><strong>Ein Gespräch über Ihren Betrieb.</strong><em>Kostenlos und unverbindlich <span aria-hidden="true">↗</span></em></a>}
  <div data-mobile-rail>
  <div class="kurs" id="kurs" data-mobile-rail-track tabindex="0" aria-label={`${page.area} Angebote: horizontal wischen oder mit den Pfeiltasten bewegen`}>
    <svg class="kurs__line" viewBox="0 0 130 1600" preserveAspectRatio="none" aria-hidden="true"><path class="kurs__track" d="M65 0 L65 1600"/><path class="kurs__path" d="M65 0 L65 1600"/></svg>
    <div class="kurs__pen"><span class="kurs__logo"><Image src={logo} alt="" width={120} format="webp" quality={82} loading="lazy" /></span></div>
    {page.journey.steps.map((step, index) => <article class:list={['station', index % 2 === 1 && 'service-station--right']} id={`format-${step.id}`} aria-label={step.label} data-mobile-rail-card>
      {step.aliases?.map(alias => <span id={alias} class="service-anchor" aria-hidden="true"></span>)}
      <span class="station__node" aria-hidden="true"></span>
      <ServiceJourneyCard step={step} area={page.area} />
    </article>)}
  </div>
  <MobileRailControls count={page.journey.steps.length} noun="Angebote" />
  </div>
  {page.related && <aside class="service-related"><p>{page.related.intro}</p><div>{page.related.links.map(link => <a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}</div></aside>}
</section>
